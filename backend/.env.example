# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vigilant_db

# Security
JWT_SECRET_KEY=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development

# Document uploads
DOCUMENT_STORAGE_DIR=./document_storage
DOCUMENT_MAX_SIZE_BYTES=10485760
DOCUMENT_PROCESSING_MAX_PAGES=50
DOCUMENT_PROCESSING_MAX_SECONDS=60
DOCUMENT_PROCESSING_MAX_TEXT_CHARS=1000000
DOCUMENT_OCR_PAGE_TIMEOUT_SECONDS=12
# Optional absolute path if the Tesseract executable is not available on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
